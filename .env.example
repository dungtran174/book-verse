# ============================================
# BookVerse - Environment Configuration Example
# ============================================
# Đổi tên file này thành .env để sử dụng trong local

# --- Server ---
SERVER_PORT=8080

# --- Database (PostgreSQL - Production) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookverse
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# --- Spring Profile ---
# Sử dụng 'dev' cho H2 in-memory, 'prod' cho PostgreSQL
SPRING_PROFILES_ACTIVE=dev

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=50MB

# --- Cache ---
CACHE_BOOK_TTL=300
CACHE_SEARCH_TTL=120
CACHE_COVER_TTL=1800

# --- Image Processing ---
THUMBNAIL_SIZE=200
MEDIUM_SIZE=500
LARGE_SIZE=1200
